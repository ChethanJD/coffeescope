# CoffeeScope environment variables
#
# The app runs on mock data (see lib/data/*) until these are set, so no
# environment variables are required to run it locally. This file is a
# placeholder — copy it to `.env.local` and fill in values as needed.
#
# cp .env.example .env.local

# --- Supabase (required for database-backed data + auth) -------------------
# Project URL and anon (public) key: safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key: SERVER-ONLY. Never prefix with NEXT_PUBLIC_, never
# import it into a Client Component, never commit a real value.
SUPABASE_SERVICE_ROLE_KEY=

# Weather: OpenWeatherMap API key (https://openweathermap.org/api).
# SERVER-ONLY — used in services/weather/liveProvider.ts. Without this set,
# the weather section clearly shows demo conditions instead of live data.
OPENWEATHER_API_KEY=

# News: NewsAPI.org API key (https://newsapi.org). SERVER-ONLY — used in
# services/news/liveProvider.ts. Without this set, the news section shows
# sample articles instead of live coverage.
NEWS_API_KEY=

# Email: Resend (https://resend.com) — sends an admin notification when
# someone submits the contact form. SERVER-ONLY. The contact message is
# always saved to the database regardless of whether these are set; this
# only controls the "someone should look at this" email notification.
RESEND_API_KEY=
CONTACT_NOTIFY_EMAIL=
CONTACT_FROM_EMAIL=

# Spam protection: Cloudflare Turnstile (free — https://dash.cloudflare.com/?to=/:account/turnstile).
# NEXT_PUBLIC_TURNSTILE_SITE_KEY is safe to expose to the browser (it's a
# public site key); TURNSTILE_SECRET_KEY is SERVER-ONLY. Without both set,
# the contact form falls back to its honeypot + rate-limit checks alone.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Example: market data provider API key
# MARKET_DATA_API_KEY=

# Example: base URL for the app (used in metadata, absolute links, etc.)
# NEXT_PUBLIC_APP_URL=http://localhost:3000
