# CoffeeScope environment variables
#
# The app currently runs entirely on mock data (see lib/data/*), so no
# environment variables are required to run it locally. This file is a
# placeholder for when real integrations are added — copy it to `.env.local`
# and fill in values as needed.
#
# cp .env.example .env.local

# Example: weather API key (if/when a real weather provider is integrated)
# WEATHER_API_KEY=

# Example: market data provider API key
# MARKET_DATA_API_KEY=

# Example: base URL for the app (used in metadata, absolute links, etc.)
# NEXT_PUBLIC_APP_URL=http://localhost:3000
